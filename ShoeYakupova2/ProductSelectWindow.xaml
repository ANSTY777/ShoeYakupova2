<Window x:Class="ShoeYakupova2.ProductSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор товара"
        Height="500" Width="700"
        FontFamily="Calibri"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Выберите товар (Поиск):" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
            <TextBox Name="TBSearch" Width="200" FontSize="16" TextChanged="TBSearch_TextChanged"/>
        </StackPanel>
        <ListView Grid.Row="1" Name="ProductListView" 
                  BorderBrush="#CCCCCC" BorderThickness="1"
                  MouseDoubleClick="ProductListView_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" 
                                    DisplayMemberBinding="{Binding ProductName}" Width="420"/>
                    <GridViewColumn Header="Цена" 
                                    DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2} ₽}" 
                                    Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Выбрать" Width="140" Height="38" FontSize="16"
                    Background="#D2F6E7" Margin="0,0,10,0"
                    Click="SelectButton_Click"/>
            <Button Content="Отмена" Width="120" Height="38" FontSize="16" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>