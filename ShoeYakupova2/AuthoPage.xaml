<Page x:Class="ShoeYakupova2.AuthoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ShoeYakupova2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация" FontFamily="Calibri">

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин" 
                   FontSize="55" 
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Center"
                   Margin="0,0,30,0"/>

        <TextBox Name="TBLogin" 
                 FontSize="30" 
                 Width="400" Height="60" 
                 Grid.Column="1"
                 VerticalContentAlignment="Center"
                 Margin="30,0,0,0"/>

        <!-- Отступы 30px в Margins, чтобы текст и кнопки не прилипали друг к другу -->
        <Button Name="GuestBtn" 
                Grid.Row="1" 
                Content="Войти как гость" 
                FontSize="20"
                Height="50"
                Margin="0,40,30,0"
                Background="#D2F6E7"
                Click="GuestBtn_Click"/>

        <Button Name="LoginBtn" 
                Grid.Row="1" 
                Grid.Column="1" 
                Content="Войти" 
                FontSize="20"
                Height="50"
                Margin="30,40,0,0"
                Background="#D2F6E7"
                Click="LoginBtn_Click"/>
    </Grid>
</Page>