<Window x:Class="ShoeYakupova2.SizeSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор размера"
        Height="320" Width="450"
        FontFamily="Calibri"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Name="ProductNameText" 
                   FontSize="18" FontWeight="Bold" 
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,15">
            <TextBlock Text="Размер:" FontSize="16" Margin="0,0,0,5"/>
            <!-- DisplayMemberPath="DisplayText" берет красивое название из класса SizeItem -->
            <ComboBox Name="SizeComboBox" FontSize="16" Height="32" 
                      DisplayMemberPath="DisplayText"
                      SelectionChanged="SizeComboBox_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Количество:" FontSize="16" 
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <Button Content="−" Width="32" Height="32" FontSize="16" 
                    Click="MinusButton_Click"/>
            <TextBlock Name="QtyText" Text="1" FontSize="18" FontWeight="Bold" 
                       Width="50" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="+" Width="32" Height="32" FontSize="16" 
                    Click="PlusButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                    Margin="0,15,0,0">
            <Button Content="Добавить" Width="140" Height="38" FontSize="16"
                    Background="#D2F6E7" Margin="0,0,10,0"
                    Click="AddButton_Click"/>
            <Button Content="Отмена" Width="120" Height="38" FontSize="16" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>