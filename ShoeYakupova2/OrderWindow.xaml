<Window x:Class="ShoeYakupova2.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Height="500" Width="900"
        FontFamily="Calibri"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ИНФО О ЗАКАЗЕ -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" 
                Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер заказа:" FontSize="16"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="OrderNumberText" FontSize="16" FontWeight="Bold"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата заказа:" FontSize="16" Margin="0,4,0,0"/>
                <DatePicker Grid.Row="1" Grid.Column="1" Name="OrderDatePicker" FontSize="16" Margin="0,4,0,0" SelectedDateChanged="OrderDatePicker_SelectedDateChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Клиент:" FontSize="16" Margin="0,4,0,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="ClientNameText" FontSize="16" Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- СПИСОК ПОЗИЦИЙ -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1">
            <ListView Name="OrderItemsListView" BorderThickness="0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Товар" 
                                        DisplayMemberBinding="{Binding ProductName}" Width="380"/>
                        <GridViewColumn Header="Размер" 
                                        DisplayMemberBinding="{Binding SizeText}" Width="90"/>
                        <GridViewColumn Header="Кол-во" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="−" Width="28" Height="28" FontSize="16" 
                                                Click="MinusButton_Click" DataContext="{Binding}"/>
                                        <TextBlock Text="{Binding Quantity}" FontSize="16" 
                                                   Width="40" TextAlignment="Center" 
                                                   VerticalAlignment="Center"/>
                                        <Button Content="+" Width="28" Height="28" FontSize="16" 
                                                Click="PlusButton_Click" DataContext="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Цена" 
                                        DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2} ₽}" 
                                        Width="110"/>
                        <GridViewColumn Header="Сумма" 
                                        DisplayMemberBinding="{Binding LineSum, StringFormat={}{0:N2} ₽}" 
                                        Width="120"/>
                        <GridViewColumn Header="" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Удалить" Width="90" Height="28" FontSize="14" 
                                            Click="RemoveButton_Click" DataContext="{Binding}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- КНОПКИ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="AddItemButton" Content="Добавить позицию" 
                    Width="180" Height="35" FontSize="16"
                    Background="#D2F6E7" Margin="0,0,10,0"
                    Click="AddItemButton_Click"/>
            <Button Name="SaveButton" Content="Сохранить" 
                    Width="150" Height="35" FontSize="16"
                    Background="#D2F6E7" Margin="0,0,10,0"
                    Click="SaveButton_Click"/>
            <Button Content="Закрыть" 
                    Width="150" Height="35" FontSize="16" 
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>