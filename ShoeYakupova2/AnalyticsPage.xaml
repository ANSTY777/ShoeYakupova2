<Page x:Class="ShoeYakupova2.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Аналитика" FontFamily="Calibri">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Аналитика продаж" 
                   FontSize="26" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Период с:" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <!-- Пересчет сразу при смене даты -->
            <DatePicker Name="StartDatePicker" Width="160" FontSize="14" 
                        SelectedDateChanged="DateChanged" Margin="0,0,15,0"/>
            <TextBlock Text="по:" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker Name="EndDatePicker" Width="160" FontSize="14" 
                        SelectedDateChanged="DateChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Name="ErrorText" Foreground="Red" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="3">
            <TextBlock Name="TotalOrdersText" Text="Всего заказов: 0" 
                       FontSize="18" Margin="0,0,0,5"/>
            <TextBlock Name="TotalSumText" Text="Общая сумма продаж: 0,00 ₽" 
                       FontSize="18" Margin="0,0,0,15"/>
            <TextBlock Text="Топ-5 моделей по проданным парам" 
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Привязка к ManufacturerName, чтобы совпадало с C# -->
            <ListView Name="TopProductsListView" Height="280" 
                      BorderBrush="#CCCCCC" BorderThickness="1">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Модель" 
                                        DisplayMemberBinding="{Binding ProductName}" Width="400"/>
                        <GridViewColumn Header="Производитель" 
                                        DisplayMemberBinding="{Binding ManufacturerName}" Width="250"/>
                        <GridViewColumn Header="Пар продано" 
                                        DisplayMemberBinding="{Binding TotalPairs}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

        <Button Grid.Row="4" Content="Экспорт в PDF" Width="200" Height="40" 
                FontSize="16" HorizontalAlignment="Right" 
                Margin="0,15,0,0" Click="ExportButton_Click"
                Background="#D2F6E7"/>
    </Grid>
</Page>